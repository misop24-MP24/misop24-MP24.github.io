---
import Base from '../layouts/Base.astro';
import Water from '../components/Water.astro';
import WorkList from '../components/WorkList.astro';
import { SITE, LINKS } from '../config';
import { getPublishedWorks } from '../lib/works';

const works = await getPublishedWorks();

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'ja' },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
    jobTitle: SITE.role,
    ...(LINKS.length > 0 ? { sameAs: LINKS.map((l) => l.url) } : {}),
  },
];
---

<Base jsonLd={jsonLd} home>
  <section class="hero">
    <Water name={SITE.name} />
    <a class="hero__cue" href="#works" aria-label="作品へ"><span></span></a>
  </section>

  <section id="works" class="works wrap" aria-labelledby="works-title">
    <h2 id="works-title" class="works__title">作品</h2>
    {works.length > 0 ? <WorkList works={works} /> : <p class="works__empty">最初の作品を準備しています。</p>}
  </section>
</Base>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
  }

  /* 下へ続く合図(細い線を、しずくが流れ落ちる) */
  .hero__cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(1.4rem, 4vh, 2.6rem);
    width: 1px;
    height: clamp(2.6rem, 7vh, 4.2rem);
    translate: -50% 0;
    background: var(--hair);
    overflow: hidden;
  }
  .hero__cue::before {
    content: '';
    position: absolute;
    inset: -1rem -1.2rem;
  }
  .hero__cue span {
    position: absolute;
    inset: 0;
    background: var(--ink);
    animation: cue 2.4s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55%,
    100% {
      transform: translateY(100%);
    }
  }
  :global(html.js) .hero__cue {
    opacity: 0;
    transition: opacity 1.2s var(--ease) 1.2s;
  }
  :global(html.js.intro-done) .hero__cue {
    opacity: 1;
  }

  .works {
    padding-top: clamp(5rem, 11vw, 9rem);
    max-width: 82rem;
    margin-inline: auto;
    width: 100%;
  }
  .works__title {
    font-size: 0.95rem;
    letter-spacing: 0.42em;
    color: var(--mist);
    margin-bottom: clamp(1.6rem, 4vw, 3rem);
  }
  .works__empty {
    color: var(--mist);
    letter-spacing: 0.14em;
  }
</style>

<script>
  // 何かの理由で水面が動かなかったときも、まわりは必ず見えるようにする
  setTimeout(() => document.documentElement.classList.add('intro-done'), 4500);
</script>
