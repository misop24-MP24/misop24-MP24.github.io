---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getPublishedWorks } from '../../lib/works';

export const getStaticPaths = (async () => {
  const works = await getPublishedWorks();
  return works.map((work, i) => ({
    params: { id: work.id },
    // 一覧の次の作品(最後の作品なら、最初に戻る)
    props: { work, next: works.length > 1 ? works[(i + 1) % works.length] : null },
  }));
}) satisfies GetStaticPaths;

const { work, next } = Astro.props;
const { title, summary, date, cover, coverAlt, tags, links, embed } = work.data;
const { Content } = await render(work);

let ogImage: string | undefined;
if (cover) {
  const og = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
  ogImage = new URL(og.src, Astro.site).href;
}

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const iso = date.toISOString().slice(0, 10);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title,
    description: summary,
    url: pageUrl,
    datePublished: iso,
    inLanguage: 'ja',
    author: { '@type': 'Person', name: SITE.name, url: SITE.url },
    ...(ogImage ? { image: ogImage } : {}),
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: '作品', item: SITE.url + '/works/' },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={summary} image={ogImage} type="article" jsonLd={jsonLd}>
  <article class="work">
    <header class="work__head wrap">
      <h1 class="work__title">{title}</h1>
      <p class="work__summary">{summary}</p>
      <ul class="work__meta">
        <li><time datetime={iso}>{date.getFullYear()}</time></li>
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    </header>

    {
      cover && (
        <figure class="work__cover wrap">
          <div class="work__cover-inner">
            <Image
              src={cover}
              alt={coverAlt ?? `${title}の画面`}
              widths={[640, 1000, 1600]}
              sizes="(min-width: 82rem) 74rem, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
      )
    }

    {
      links.length > 0 && (
        <ul class="work__actions wrap">
          {links.map((l, i) => (
            <li>
              <a class:list={['btn', { 'btn--solid': i === 0 }]} href={l.url} target="_blank" rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      embed && (
        <div class="work__embed wrap">
          <div class="work__embed-inner">
            <iframe
              src={embed}
              title={`${title}を遊ぶ`}
              loading="lazy"
              allow="fullscreen; autoplay; gamepad"
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>
        </div>
      )
    }

    <div class="work__body wrap">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    next && (
      <nav class="next wrap" aria-label="次の作品">
        <a class="next__link" href={`/works/${next.id}/`}>
          <span class="next__label">次の作品</span>
          <span class="next__title">{next.data.title}</span>
        </a>
      </nav>
    )
  }
</Base>

<style>
  .work__head {
    max-width: 82rem;
    margin-inline: auto;
    padding-top: clamp(8rem, 18vw, 13rem);
    padding-bottom: clamp(2.4rem, 5vw, 4rem);
  }
  .work__title {
    font-size: clamp(2.2rem, 7vw, 5.6rem);
    line-height: 1.25;
    letter-spacing: 0.12em;
  }
  .work__summary {
    margin-top: clamp(1.2rem, 3vw, 2rem);
    max-width: 34rem;
    color: var(--ink-mid);
  }
  .work__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.6rem;
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--mist);
  }
  .work__meta time {
    font-family: var(--roman);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
  }

  .work__cover {
    margin: 0 auto;
    max-width: 82rem;
  }
  .work__cover-inner :global(img) {
    width: 100%;
    height: auto;
  }
  /* 中心から、波紋が広がるように現れる */
  :global(html.js) .work__cover-inner {
    clip-path: circle(0% at 50% 50%);
    animation: spread 1.6s var(--ease-out) 0.25s forwards;
  }
  @keyframes spread {
    to {
      clip-path: circle(75% at 50% 50%);
    }
  }

  .work__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    list-style: none;
    margin: clamp(2.4rem, 5vw, 3.6rem) auto 0;
    max-width: 82rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.5rem 2.1rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    letter-spacing: 0.18em;
    font-size: 0.95rem;
    line-height: 1.5;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.5s var(--ease);
  }
  /* カーソルが触れたところから、波紋のように色が広がる */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    clip-path: circle(0% at var(--rx, 50%) var(--ry, 50%));
    transition: clip-path 0.7s var(--ease-out);
  }
  .btn:hover,
  .btn:focus-visible {
    color: var(--paper);
  }
  .btn:hover::before,
  .btn:focus-visible::before {
    clip-path: circle(160% at var(--rx, 50%) var(--ry, 50%));
  }
  .btn--solid {
    background: var(--ink);
    color: var(--paper);
  }
  .btn--solid::before {
    background: var(--paper);
  }
  .btn--solid:hover,
  .btn--solid:focus-visible {
    color: var(--ink);
  }

  .work__embed {
    max-width: 82rem;
    margin: clamp(3rem, 6vw, 4.4rem) auto 0;
  }
  .work__embed-inner {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--paper-deep);
  }
  .work__embed-inner iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .work__body {
    max-width: 82rem;
    margin: clamp(4rem, 9vw, 7rem) auto 0;
  }
  .work__body .prose {
    margin-left: clamp(0rem, 16vw, 16rem);
  }
  @media (max-width: 48rem) {
    .work__body .prose {
      margin-left: 0;
    }
  }

  .next {
    max-width: 82rem;
    margin: clamp(6rem, 14vw, 11rem) auto 0;
    width: 100%;
  }
  .next__link {
    display: block;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--hair);
  }
  .next__label {
    display: block;
    font-size: 0.85rem;
    letter-spacing: 0.32em;
    color: var(--mist);
  }
  .next__title {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: clamp(1.9rem, 5.4vw, 4.2rem);
    line-height: 1.3;
    letter-spacing: 0.1em;
    transition: transform 0.9s var(--ease-out);
  }
  .next__link:hover .next__title,
  .next__link:focus-visible .next__title {
    transform: translateX(0.5em);
  }
</style>

<script>
  // ボタンの波紋が、カーソルの入ってきた位置から広がるようにする
  document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
    btn.addEventListener('pointerenter', (e) => {
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--rx', `${e.clientX - r.left}px`);
      btn.style.setProperty('--ry', `${e.clientY - r.top}px`);
    });
  });
</script>
