---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import { SITE } from '../../config';
import { getPublishedWorks } from '../../lib/works';

const works = await getPublishedWorks();
---

<Base title="作品" description={`${SITE.name}が作ったゲームの一覧です。ブラウザで遊べるものや、販売中のものがあります。`}>
  <section class="page wrap">
    <h1 class="page__title">作品</h1>
    {works.length > 0 ? <WorkList works={works} /> : <p class="page__empty">最初の作品を準備しています。</p>}
  </section>
</Base>

<style>
  .page {
    max-width: 82rem;
    margin-inline: auto;
    width: 100%;
    padding-top: clamp(8rem, 18vw, 13rem);
  }
  .page__title {
    font-size: 0.95rem;
    letter-spacing: 0.42em;
    color: var(--mist);
    margin-bottom: clamp(1.6rem, 4vw, 3rem);
  }
  .page__empty {
    color: var(--mist);
    letter-spacing: 0.14em;
  }
</style>
