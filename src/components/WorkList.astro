---
// 作品の一覧。年ごとに区切って、大きな作品名を縦に並べます。
// 作品名の下に一言コメント、右にタグが出ます。
// マウスを乗せると、その行の空いたところに小さな丸い写真が広がり、まわりに波紋が立ちます。
// スマホでは、各行の右に小さな丸い写真が出ます。
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Ripples from './Ripples.astro';

interface Props {
  works: CollectionEntry<'works'>[];
}
const { works } = Astro.props;

const seedOf = (id: string) => [...id].reduce((s, ch) => (s * 31 + ch.charCodeAt(0)) % 9973, 7);

const items = await Promise.all(
  works.map(async (w) => {
    const img = w.data.cover ? await getImage({ src: w.data.cover, width: 720, height: 720, fit: 'cover', format: 'webp' }) : null;
    const thumb = w.data.cover ? await getImage({ src: w.data.cover, width: 160, height: 160, fit: 'cover', format: 'webp' }) : null;
    // ネット上の画像URLのときは、そのまま使う
    return { work: w, img: img?.src ?? w.data.coverUrl, thumb: thumb?.src ?? w.data.coverUrl, seed: seedOf(w.id) };
  }),
);

// 年ごとにまとめる(新しい年が上)
const groups: { year: number; items: ((typeof items)[number] & { index: number })[] }[] = [];
items.forEach((item, index) => {
  const year = item.work.data.date.getFullYear();
  let g = groups.find((x) => x.year === year);
  if (!g) {
    g = { year, items: [] };
    groups.push(g);
  }
  g.items.push({ ...item, index });
});
groups.sort((x, y) => y.year - x.year);
---

<work-list class="list">
  {
    groups.map((g) => (
      <section class="year" aria-label={`${g.year}年の作品`}>
        <h3 class="year__label">{g.year}</h3>
        <ul class="year__rows">
          {g.items.map(({ work, thumb, seed, index }) => (
            <li>
              <a class="row" href={`/works/${work.id}/`} data-index={index}>
                <span class="row__title">{work.data.title}</span>
                {work.data.comment && <span class="row__comment">{work.data.comment}</span>}
                {work.data.tags.length > 0 && (
                  <span class="row__tags">
                    {work.data.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </span>
                )}
                <span class="row__thumb" aria-hidden="true">
                  {thumb ? (
                    <img src={thumb} alt="" width="80" height="80" loading="lazy" decoding="async" />
                  ) : (
                    <span class="row__rings">
                      <Ripples seed={seed} />
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="preview" aria-hidden="true">
    <span class="preview__ring"></span>
    <span class="preview__ring"></span>
    <span class="preview__ring"></span>
    {
      items.map(({ img, seed }, i) => (
        <div class="preview__item" data-index={i}>
          {img ? (
            <img src={img} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="preview__rings">
              <Ripples seed={seed} />
            </div>
          )}
        </div>
      ))
    }
  </div>
</work-list>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 年の区切り: 左に年、右にその年の作品 */
  .year {
    display: grid;
    grid-template-columns: clamp(5rem, 11vw, 9rem) minmax(0, 1fr);
    gap: 0 clamp(1rem, 3vw, 2.4rem);
    padding-block: clamp(1.6rem, 3.6vw, 2.8rem);
    border-top: 1px solid var(--hair);
  }
  .year:last-child {
    border-bottom: 1px solid var(--hair);
  }
  .year__label {
    font-family: var(--roman);
    font-weight: 300;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    letter-spacing: 0.08em;
    color: var(--mist);
    font-variant-numeric: oldstyle-nums;
    padding-top: clamp(1.15rem, 2.6vw, 2.1rem);
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title tags'
      'comment tags';
    align-items: baseline;
    column-gap: 1.6rem;
    padding-block: clamp(0.9rem, 2vw, 1.5rem);
    transition: opacity 0.6s var(--ease);
  }
  .row__title {
    grid-area: title;
    justify-self: start;
    font-size: clamp(1.7rem, 4.2vw, 3.3rem);
    line-height: 1.35;
    letter-spacing: 0.1em;
    transition: transform 0.8s var(--ease-out);
  }
  .row__comment {
    grid-area: comment;
    justify-self: start;
    margin-top: 0.35rem;
    font-size: 0.92rem;
    line-height: 1.8;
    letter-spacing: 0.08em;
    color: var(--ink-mid);
    transition: transform 0.8s var(--ease-out) 0.04s;
  }
  .row__tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
    max-width: 16rem;
    align-self: center;
  }
  .tag {
    font-size: 0.74rem;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--mist);
    padding: 0.42em 0.85em 0.42em 0.97em;
    border: 1px solid var(--hair);
    border-radius: 999px;
    white-space: nowrap;
  }
  .row__thumb {
    grid-area: thumb;
    display: none;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    overflow: hidden;
    align-self: center;
    background: var(--paper-deep);
  }
  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__rings {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink-mid);
  }

  /* 他の作品を薄くして、指している作品だけを浮かび上がらせる */
  @media (hover: hover) and (pointer: fine) {
    .list:has(.row:hover) .row:not(:hover) {
      opacity: 0.22;
    }
    .row:hover .row__title,
    .row:focus-visible .row__title,
    .row:hover .row__comment,
    .row:focus-visible .row__comment {
      transform: translateX(0.6rem);
    }
  }
  @media (hover: none), (pointer: coarse) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'title thumb'
        'comment thumb'
        'tags thumb';
      align-items: center;
    }
    .row__tags {
      justify-content: flex-start;
      max-width: none;
      margin-top: 0.6rem;
    }
    .row__thumb {
      display: block;
    }
    .preview {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .year {
      grid-template-columns: 1fr;
    }
    .year__label {
      position: static;
      padding-top: 0;
      margin-bottom: 0.2rem;
    }
  }

  /* 指している作品の行の、空いているところに出る小さな丸い写真(横はカーソルに合わせて動く) */
  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 15;
    width: clamp(5.5rem, 8vw, 7.5rem);
    aspect-ratio: 1;
    pointer-events: none;
    translate: var(--x, -999px) var(--y, -999px);
  }
  .preview__item {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    translate: -50% -50%;
    border-radius: 50%;
    overflow: hidden;
    clip-path: circle(0% at 50% 50%);
    transition: clip-path 0.8s var(--ease-out);
  }
  .preview__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.3;
    transition: scale 1.4s var(--ease-out);
  }
  .preview__item.is-on {
    clip-path: circle(50% at 50% 50%);
  }
  .preview__item.is-on img {
    scale: 1;
  }
  .preview__rings {
    width: 100%;
    height: 100%;
    padding: 6%;
    background: var(--paper-deep);
    color: var(--ink-mid);
  }

  /* 写真が現れるとき、まわりに広がって消える波紋 */
  .preview__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid var(--ink);
    opacity: 0;
  }
  .preview.is-ripple .preview__ring {
    animation: ring 1.6s var(--ease-out) both;
  }
  .preview.is-ripple .preview__ring:nth-child(2) {
    animation-delay: 0.16s;
  }
  .preview.is-ripple .preview__ring:nth-child(3) {
    animation-delay: 0.32s;
  }
  @keyframes ring {
    0% {
      scale: 0.6;
      opacity: 0;
    }
    18% {
      opacity: 0.45;
    }
    100% {
      scale: 1.9;
      opacity: 0;
    }
  }
</style>

<script>
  class WorkList extends HTMLElement {
    connectedCallback() {
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!fine) return;
      const preview = this.querySelector<HTMLElement>('.preview')!;
      const items = [...this.querySelectorAll<HTMLElement>('.preview__item')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let running = false;
      let placed = false;
      let current: HTMLElement | null = null;
      let pointerX = 0;

      const loop = () => {
        // 少し遅れてついてくる(水に浮かんでいるような間)
        const k = reduce ? 1 : 0.14;
        x += (tx - x) * k;
        y += (ty - y) * k;
        preview.style.setProperty('--x', `${x}px`);
        preview.style.setProperty('--y', `${y}px`);
        if (Math.abs(tx - x) > 0.2 || Math.abs(ty - y) > 0.2) requestAnimationFrame(loop);
        else running = false;
      };

      // 写真の置き場所: 行の高さの真ん中で、作品名・コメントとタグのあいだの空いたところ。
      // 横はカーソルに合わせて動くが、文字やタグには重ならない
      const target = () => {
        if (!current) return;
        const w = preview.getBoundingClientRect().width;
        const gap = 24;
        const row = current.getBoundingClientRect();
        const title = current.querySelector('.row__title')?.getBoundingClientRect();
        const comment = current.querySelector('.row__comment')?.getBoundingClientRect();
        const tags = current.querySelector('.row__tags')?.getBoundingClientRect();
        const textRight = Math.max(title?.right ?? row.left, comment?.right ?? row.left);
        const minX = textRight + gap + w / 2;
        const maxX = (tags ? tags.left : row.right) - gap - w / 2;
        tx = minX <= maxX ? Math.min(maxX, Math.max(minX, pointerX)) : (textRight + (tags ? tags.left : row.right)) / 2;
        ty = row.top + row.height / 2;
        if (!placed) {
          x = tx;
          y = ty;
          placed = true;
        }
        if (!running) {
          running = true;
          requestAnimationFrame(loop);
        }
      };

      this.addEventListener('pointermove', (e) => {
        pointerX = e.clientX;
        target();
      });
      window.addEventListener('scroll', target, { passive: true });

      const show = (i: number | null) => {
        items.forEach((el, n) => el.classList.toggle('is-on', n === i));
        if (i !== null && !reduce) {
          // 波紋をもう一度立てる
          preview.classList.remove('is-ripple');
          void preview.offsetWidth;
          preview.classList.add('is-ripple');
        }
      };
      this.querySelectorAll<HTMLElement>('.row').forEach((row) => {
        row.addEventListener('pointerenter', (e) => {
          current = row;
          pointerX = e.clientX;
          target();
          show(Number(row.dataset.index));
        });
        row.addEventListener('pointerleave', () => {
          current = null;
          show(null);
        });
      });
      this.addEventListener('pointerleave', () => {
        show(null);
        placed = false;
      });
    }
  }
  if (!customElements.get('work-list')) customElements.define('work-list', WorkList);
</script>
