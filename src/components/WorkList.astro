---
// 作品の一覧。大きな作品名を縦に並べます。
// マウスを乗せると、カーソルの位置に画面写真が丸く広がり、そのまわりに波紋が立ちます。
// スマホでは、各行の右に小さな丸い写真が出ます。
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Ripples from './Ripples.astro';

interface Props {
  works: CollectionEntry<'works'>[];
}
const { works } = Astro.props;

const seedOf = (id: string) => [...id].reduce((s, ch) => (s * 31 + ch.charCodeAt(0)) % 9973, 7);

const items = await Promise.all(
  works.map(async (w) => {
    const img = w.data.cover ? await getImage({ src: w.data.cover, width: 720, height: 720, fit: 'cover', format: 'webp' }) : null;
    const thumb = w.data.cover ? await getImage({ src: w.data.cover, width: 160, height: 160, fit: 'cover', format: 'webp' }) : null;
    return { work: w, img: img?.src, thumb: thumb?.src, seed: seedOf(w.id) };
  }),
);
---

<work-list class="list">
  <ul>
    {
      items.map(({ work, thumb, seed }, i) => (
        <li>
          <a class="row" href={`/works/${work.id}/`} data-index={i}>
            <span class="row__title">{work.data.title}</span>
            <span class="row__thumb" aria-hidden="true">
              {thumb ? (
                <img src={thumb} alt="" width="80" height="80" loading="lazy" decoding="async" />
              ) : (
                <span class="row__rings">
                  <Ripples seed={seed} />
                </span>
              )}
            </span>
            <span class="row__year">{work.data.date.getFullYear()}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="preview" aria-hidden="true">
    <span class="preview__ring"></span>
    <span class="preview__ring"></span>
    <span class="preview__ring"></span>
    {
      items.map(({ img, seed }, i) => (
        <div class="preview__item" data-index={i}>
          {img ? (
            <img src={img} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="preview__rings">
              <Ripples seed={seed} />
            </div>
          )}
        </div>
      ))
    }
  </div>
</work-list>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 1.4rem;
    padding-block: clamp(0.9rem, 2.2vw, 1.6rem);
    transition: opacity 0.6s var(--ease);
  }
  .row__title {
    font-size: clamp(1.75rem, 4.6vw, 3.6rem);
    line-height: 1.35;
    letter-spacing: 0.1em;
    transition: transform 0.8s var(--ease-out);
  }
  .row__year {
    font-family: var(--roman);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--mist);
    font-variant-numeric: oldstyle-nums;
  }
  .row__thumb {
    display: none;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    overflow: hidden;
    align-self: center;
    background: var(--paper-deep);
  }
  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__rings {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink-mid);
  }

  /* 他の行を薄くして、指している作品だけを浮かび上がらせる */
  @media (hover: hover) and (pointer: fine) {
    ul:hover .row {
      opacity: 0.22;
    }
    ul:hover .row:hover,
    .row:focus-visible {
      opacity: 1;
    }
    .row:hover .row__title,
    .row:focus-visible .row__title {
      transform: translateX(0.6em);
    }
  }
  @media (hover: none), (pointer: coarse) {
    .row {
      align-items: center;
    }
    .row__thumb {
      display: block;
    }
    .preview {
      display: none;
    }
  }

  /* カーソルについてくる丸い写真 */
  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 15;
    width: clamp(14rem, 24vw, 22rem);
    aspect-ratio: 1;
    pointer-events: none;
    translate: var(--x, -999px) var(--y, -999px);
  }
  .preview__item {
    position: absolute;
    inset: 0;
    margin: -50% 0 0 -50%;
    border-radius: 50%;
    overflow: hidden;
    clip-path: circle(0% at 50% 50%);
    transition: clip-path 0.8s var(--ease-out);
  }
  .preview__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.3;
    transition: scale 1.4s var(--ease-out);
  }
  .preview__item.is-on {
    clip-path: circle(50% at 50% 50%);
  }
  .preview__item.is-on img {
    scale: 1;
  }
  .preview__rings {
    width: 100%;
    height: 100%;
    padding: 6%;
    background: var(--paper-deep);
    color: var(--ink-mid);
  }

  /* 写真が現れるとき、まわりに広がって消える波紋 */
  .preview__ring {
    position: absolute;
    inset: 0;
    margin: -50% 0 0 -50%;
    border-radius: 50%;
    border: 1px solid var(--ink);
    opacity: 0;
  }
  .preview.is-ripple .preview__ring {
    animation: ring 1.6s var(--ease-out) both;
  }
  .preview.is-ripple .preview__ring:nth-child(2) {
    animation-delay: 0.16s;
  }
  .preview.is-ripple .preview__ring:nth-child(3) {
    animation-delay: 0.32s;
  }
  @keyframes ring {
    0% {
      scale: 0.6;
      opacity: 0;
    }
    18% {
      opacity: 0.45;
    }
    100% {
      scale: 1.55;
      opacity: 0;
    }
  }
</style>

<script>
  class WorkList extends HTMLElement {
    connectedCallback() {
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!fine) return;
      const preview = this.querySelector<HTMLElement>('.preview')!;
      const items = [...this.querySelectorAll<HTMLElement>('.preview__item')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let running = false;
      let placed = false;

      const loop = () => {
        // 少し遅れてついてくる(水に浮かんでいるような間)
        const k = reduce ? 1 : 0.12;
        x += (tx - x) * k;
        y += (ty - y) * k;
        preview.style.setProperty('--x', `${x}px`);
        preview.style.setProperty('--y', `${y}px`);
        if (Math.abs(tx - x) > 0.2 || Math.abs(ty - y) > 0.2) requestAnimationFrame(loop);
        else running = false;
      };

      this.addEventListener('pointermove', (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!placed) {
          x = tx;
          y = ty;
          placed = true;
        }
        if (!running) {
          running = true;
          requestAnimationFrame(loop);
        }
      });

      const show = (i: number | null) => {
        items.forEach((el, n) => el.classList.toggle('is-on', n === i));
        if (i !== null && !reduce) {
          // 波紋をもう一度立てる
          preview.classList.remove('is-ripple');
          void preview.offsetWidth;
          preview.classList.add('is-ripple');
        }
      };
      this.querySelectorAll<HTMLElement>('.row').forEach((row) => {
        row.addEventListener('pointerenter', () => show(Number(row.dataset.index)));
        row.addEventListener('pointerleave', () => show(null));
      });
      this.addEventListener('pointerleave', () => {
        show(null);
        placed = false;
      });
    }
  }
  if (!customElements.get('work-list')) customElements.define('work-list', WorkList);
</script>
