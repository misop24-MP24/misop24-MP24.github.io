---
// 毛筆の円相(canvas)。
// intro: ページを開いたときに、筆で描く演出をします(トップページ用)
// 演出なしのときは、表示された時点で描き終わった状態で出ます。
import Enso from './Enso.astro';

interface Props {
  seed?: number;
  intro?: boolean;
  class?: string;
}
const { seed = 3, intro = false, class: className = '' } = Astro.props;
---

<ink-enso class:list={['ink-enso', className]} data-seed={seed} data-intro={intro ? '' : undefined}>
  <canvas aria-hidden="true"></canvas>
  <noscript><Enso seed={seed} /></noscript>
</ink-enso>

<style>
  ink-enso {
    display: block;
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { ensoReveal, computeEnso } from '../lib/brush';
  import BrushWorker from '../lib/brush.worker.ts?worker';

  const easeBrush = (t: number) => {
    // 置いて、ためて、一気に回して、ゆっくり抜く
    const a = t < 0.12 ? (t / 0.12) ** 2 * 0.06 : 0.06 + (1 - Math.pow(1 - (t - 0.12) / 0.88, 2.4)) * 0.94;
    return Math.min(1, a);
  };

  function inkRGB(): [number, number, number] {
    const v = getComputedStyle(document.documentElement).getPropertyValue('--ink-rgb');
    const p = v.split(',').map((x) => parseFloat(x));
    return p.length === 3 && p.every((x) => !Number.isNaN(x)) ? (p as [number, number, number]) : [28, 33, 39];
  }

  class InkEnso extends HTMLElement {
    private canvas!: HTMLCanvasElement;
    private image: HTMLCanvasElement | null = null;
    private progress = 0;
    private size = 0;
    private dpr = 1;
    private reveal!: ReturnType<typeof ensoReveal>;
    private worker: Worker | null = null;

    connectedCallback() {
      this.canvas = this.querySelector('canvas')!;
      const seed = Number(this.dataset.seed ?? 3);
      this.reveal = ensoReveal(seed);
      const rect = this.getBoundingClientRect();
      this.size = Math.max(1, Math.round(rect.width));
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      const px = Math.min(1600, Math.round(this.size * this.dpr));
      this.canvas.width = this.canvas.height = Math.round(this.size * this.dpr);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const intro = this.hasAttribute('data-intro') && !reduce;

      const done = (data: Uint8ClampedArray, n: number) => {
        const c = document.createElement('canvas');
        c.width = c.height = n;
        c.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(data), n, n), 0, 0);
        this.image = c;
        if (intro) this.play();
        else {
          this.progress = 1;
          this.paint();
          this.dispatchEvent(new CustomEvent('enso:done', { bubbles: true }));
        }
      };

      try {
        this.worker = new BrushWorker();
        this.worker.onmessage = (e) => {
          done(e.data.data, e.data.px);
          this.worker?.terminate();
          this.worker = null;
        };
        this.worker.postMessage({ px, rgb: inkRGB(), seed });
      } catch {
        setTimeout(() => done(computeEnso(px, inkRGB(), seed), px), 0);
      }

      // 画面の大きさが変わったら、描き終わった状態で描き直す
      let raf = 0;
      new ResizeObserver(() => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const w = Math.round(this.getBoundingClientRect().width);
          if (!w || w === this.size) return;
          this.size = w;
          this.canvas.width = this.canvas.height = Math.round(w * this.dpr);
          this.paint();
        });
      }).observe(this);
    }

    private paint() {
      const ctx = this.canvas.getContext('2d')!;
      const s = this.size;
      ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      ctx.clearRect(0, 0, s, s);
      if (!this.image || this.progress <= 0) return;
      ctx.save();
      this.reveal.clip(ctx, this.progress, s);
      ctx.clip();
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(this.image, 0, 0, s, s);
      ctx.restore();
    }

    private play() {
      let seen = false;
      try {
        seen = sessionStorage.getItem('enso-seen') === '1';
        sessionStorage.setItem('enso-seen', '1');
      } catch {}
      const wait = seen ? 120 : 380; // 筆を置く前の間
      const dur = seen ? 1050 : 1750;
      document.documentElement.classList.add(seen ? 'intro-quick' : 'intro-full');
      document.documentElement.classList.add('intro-run');
      const t0 = performance.now() + wait;
      let fired = false;
      const tick = (now: number) => {
        const t = Math.max(0, (now - t0) / dur);
        this.progress = t <= 0 ? 0 : Math.max(0.0005, easeBrush(Math.min(1, t)));
        this.paint();
        if (!fired && t >= 0.82) {
          fired = true;
          document.documentElement.classList.add('intro-done');
          this.dispatchEvent(new CustomEvent('enso:done', { bubbles: true }));
        }
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }

  if (!customElements.get('ink-enso')) customElements.define('ink-enso', InkEnso);
</script>
