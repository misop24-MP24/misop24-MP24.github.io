---
import '../styles/global.css';
import { SITE, LINKS } from '../config';
import Enso from '../components/Enso.astro';
import Seal from '../components/Seal.astro';

interface Props {
  // ページのタイトル。トップページだけは省略します
  title?: string;
  description?: string;
  // 共有したときに出る画像のURL(省略するとサイト共通の画像)
  image?: string;
  type?: 'website' | 'article';
  // 検索エンジンに載せたくないページは true
  noindex?: boolean;
  // 検索エンジン向けの構造化データ(JSON)
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.description, image, type = 'website', noindex = false, jsonLd = [] } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL('/og.png', Astro.site).href;
const path = Astro.url.pathname;
const isWorks = path.startsWith('/works/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label={`${SITE.name} トップへ`}>
          <span class="brand__mark"><Enso seed={7} /></span>
          <span class="brand__name">{SITE.name}</span>
        </a>
        <nav aria-label="メイン">
          <ul class="nav">
            <li><a href="/works/" aria-current={isWorks ? 'page' : undefined}>作品</a></li>
            <li><a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>紹介</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <hr class="brush-rule" />
        <div class="site-footer__inner">
          <Seal size="sm" />
          {
            LINKS.length > 0 && (
              <ul class="site-footer__links">
                {LINKS.map((l) => (
                  <li>
                    <a href={l.url} rel="me noopener" target="_blank">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          <small>© {year} {SITE.name}</small>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-block: 1.4rem;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    letter-spacing: 0.2em;
    font-size: 1.05rem;
  }
  .brand__mark {
    width: 1.9rem;
    flex: none;
    transition: transform 1.2s cubic-bezier(0.3, 0.1, 0.2, 1);
  }
  .brand:hover .brand__mark {
    transform: rotate(120deg);
  }
  .nav {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    text-decoration: none;
    letter-spacing: 0.3em;
    padding-block: 0.4rem;
    background: linear-gradient(currentColor, currentColor) bottom / 0 1px no-repeat;
    transition: background-size 0.4s ease;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    background-size: 100% 1px;
  }

  .site-footer {
    margin-top: 6rem;
    padding-bottom: 2.4rem;
    color: var(--sumi-soft);
    font-size: 0.85rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.6rem;
    padding-top: 2rem;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer small {
    margin-left: auto;
    letter-spacing: 0.1em;
  }
  @media (max-width: 34rem) {
    .site-footer small {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
