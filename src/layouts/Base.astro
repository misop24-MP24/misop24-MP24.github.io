---
import '@fontsource/zen-old-mincho/400.css';
import '@fontsource/zen-old-mincho/500.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '../styles/global.css';
import { SITE, LINKS } from '../config';
import Ripples from '../components/Ripples.astro';

interface Props {
  // ページのタイトル。トップページだけは省略します
  title?: string;
  description?: string;
  // 共有したときに出る画像のURL(省略するとサイト共通の画像)
  image?: string;
  type?: 'website' | 'article';
  // 検索エンジンに載せたくないページは true
  noindex?: boolean;
  // 検索エンジン向けの構造化データ(JSON)
  jsonLd?: Record<string, unknown>[];
  // トップページのときは true(開いたときの演出を有効にします)
  home?: boolean;
}

const { title, description = SITE.description, image, type = 'website', noindex = false, jsonLd = [], home = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL('/og.png', Astro.site).href;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja" class:list={{ 'is-home': home }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e3e7e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1416" media="(prefers-color-scheme: dark)" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header wrap">
      <a class="mark" href="/" aria-label={`${SITE.name} トップへ`}>
        <Ripples variant="mark" />
      </a>
      <nav aria-label="メイン">
        <ul class="nav">
          <li>
            <a class="ink-link" href="/works/" aria-current={path.startsWith('/works/') ? 'page' : undefined}>作品</a>
          </li>
          <li>
            <a class="ink-link" href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>紹介</a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <span class="site-footer__mark"><Ripples variant="mark" /></span>
      {
        LINKS.length > 0 && (
          <ul class="site-footer__links">
            {LINKS.map((l) => (
              <li>
                <a class="ink-link" href={l.url} rel="me noopener" target="_blank">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <small>© {year} {SITE.name}</small>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1.1rem, 3vw, 2rem);
  }
  .mark {
    display: block;
    width: 1.75rem;
  }
  .mark :global(circle) {
    transition: r 0.9s var(--ease-out);
  }
  .mark:hover :global(circle:nth-child(1)) {
    r: 6;
  }
  .mark:hover :global(circle:nth-child(2)) {
    r: 13;
  }
  .mark:hover :global(circle:nth-child(3)) {
    r: 19;
  }
  .nav {
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
    letter-spacing: 0.32em;
  }
  .nav a[aria-current='page'] {
    background-size: 100% 1px;
  }

  /* トップでは、最初の波紋が広がってから現れる */
  :global(html.js.is-home) .site-header,
  :global(html.js.is-home) .site-footer {
    opacity: 0;
    transition: opacity 1.4s var(--ease) 0.5s;
  }
  :global(html.js.is-home.intro-done) .site-header,
  :global(html.js.is-home.intro-done) .site-footer {
    opacity: 1;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 2rem;
    margin-top: clamp(6rem, 14vw, 11rem);
    padding-bottom: clamp(1.6rem, 3vw, 2.4rem);
    font-size: 0.82rem;
    color: var(--mist);
  }
  .site-footer__mark {
    width: 1.3rem;
    color: var(--ink);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    letter-spacing: 0.12em;
  }
  .site-footer small {
    margin-left: auto;
    font-family: var(--roman);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }
</style>
